{;; Default classpath = the shadow-cljs build (shadow-cljs.edn uses :deps true).
 ;; katamorph + Clio are consumed from immutable git refs in the
 ;; standalone open-hax repos, never from removed local packages/ copies.
 ;; Generic event/schema/admission laws are consumed from immutable Clio source.
 ;; turn-processor + eta-mu are consumed as pinned git subdirectory deps:
 ;; the provider adapter wires their run-loop/stream-fn/tools into sol's
 ;; agent sessions. After E1.06 these will point to the new open-hax repos.
 :paths ["src/cljs" "test/cljs"]

 :deps
 {thheller/shadow-cljs            {:mvn/version "3.4.11"}
  metosin/malli                   {:mvn/version "0.16.4"}
  funcool/promesa                 {:mvn/version "11.0.678"}
  cider/cider-nrepl               {:mvn/version "0.50.2"}
  refactor-nrepl/refactor-nrepl   {:mvn/version "3.9.1"}
   open-hax/turn-processor         {:git/url "https://github.com/open-hax/eta-mu.git"
                                    :git/sha "0ed56aa74a53a1d1e9c2e55ce95451817a7f3a90"
                                    :deps/root "packages/turn-processor"}
   open-hax/eta-mu                 {:git/url "https://github.com/open-hax/eta-mu.git"
                                    :git/sha "0ed56aa74a53a1d1e9c2e55ce95451817a7f3a90"
                                    :deps/root "packages/eta-mu"}
  io.github.open-hax/katamorph    {:git/tag "v0.2.0"
                                    :git/sha "305a5e49d834aca27566f739e8510f6b409fda78"}
  io.github.open-hax/clio         {:git/url "https://github.com/riatzukiza/clio.git"
                                    :git/sha "d421e929611ddff35a7f819f58bef92680bddef3"}}

 :aliases
 ;; Clojure-first mutation harness (mutation/knoxx/…) — mutates CLJS source
 ;; forms before shadow compiles them. Its own classpath, kept off the shadow
 ;; build. See mutation/README.md.
 {:mutation
  {:extra-paths ["mutation"]
   :extra-deps {org.clojure/clojure      {:mvn/version "1.12.0"}
                org.clojure/tools.reader {:mvn/version "1.5.2"}
                rewrite-clj/rewrite-clj  {:mvn/version "1.1.49"}}
   :main-opts ["-m" "knoxx.mutation-test"]}

  :mutation-test
  {:extra-paths ["mutation" "test/clj"]
   :extra-deps {org.clojure/clojure      {:mvn/version "1.12.0"}
                org.clojure/tools.reader {:mvn/version "1.5.2"}
                rewrite-clj/rewrite-clj  {:mvn/version "1.1.49"}
                io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner"
               "--namespace-regex" "^knoxx\\..*-test$"]}}}
